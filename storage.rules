rules_version = '2';

// Firebase Storage Security Rules for CNN Analyzer
service firebase.storage {
  match /b/{bucket}/o {
    
    // DATA FILES - Public read access (for testing)
    match /data/{fileName} {
      // Allow public read access
      allow read: if true;
      
      // Keep write restricted to admins
      allow write: if request.auth != null 
                   && request.auth.token.admin == true;
    }
    
    // ==================================================
    // USER-SPECIFIC FILES
    // ==================================================
    
    // User-specific simulation results and reports
    match /users/{userId}/{allPaths=**} {
      // Users can read/write their own files
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId;
    }
    
    // ==================================================
    // DEFAULT DENY
    // ==================================================
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
